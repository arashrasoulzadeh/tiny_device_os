# Copy to device_secrets.yaml (gitignored) and set your network.
# `make usb` will not flash a board until both values are real.
# ssid: 1–32 characters. password: 1–64 characters.
# Quote a value if it contains '#' or ':'.
# `user` / `pass` are accepted aliases for ssid / password.

wifi:
  ssid: "your-network"
  password: "your-password"

# Pre-shared link key. Required when notifications.forward_from_host is on.
# 32 hex digits (16 bytes). key_id is sent in Hello. Change both and reflash
# to rotate. The key is not written into device_config.yaml.
# link:
#   key_id: 1
#   key: "00112233445566778899aabbccddeeff"
