# ArdubotOS connected-device profile (copy to device_config.yaml)
# Used by `make usb` / scripts/usb_flash.py

device:
  name: nodemcu
  arch: esp8266
  board: nodemcu
  pio_env: nodemcu
  port: auto
  baud: 115200
  flash_baud: 460800
  flash_size: 4MB
  flash_mode: dio

lcd:
  type: ssd1306
  width: 128
  height: 32
  bus: i2c
  address: 0x3C
  scl: D6
  sda: D7

inputs:
  buttons:
    - name: primary
      pin: D5
      active_low: true
      pull: up

outputs:
  leds: []
  sound: null

# Optional: which stdapps to compile in for this device (ARDUBOT_ENABLED_APPS).
# Omit this section entirely to auto-select instead - every stdapp whose
# apps/stdapps/<name>/package.json "min_display" fits the lcd size above
# gets compiled in, everything else is left out. Only applies to non-sim
# ARCH builds (`make usb` / `make ARCH=esp8266 ...`) - sim always builds
# everything. Check with: python3 scripts/device_config.py apps
# apps:
#   - counter
#   - info
