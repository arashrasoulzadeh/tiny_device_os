# Wi-Fi credentials (copy from device_secrets.yaml.example)
device_secrets.yaml

# PlatformIO (make usb)
.pio/
.venv-pio/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Build directories
build/
build-*/
cmake-build-*/
*.cmake.build/

# CMake (generated Makefiles live under build/, already ignored above)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.cmake.orig

# Crash dumps from the sim's signal handler (sim/sim_main.c)
crash.log

# Generated docs (make docs / mkdocs build)
docs/doxygen/
/site/

# IDE (editor state only — settings.json and extensions.json stay tracked)
.idea/
*.swp
*.swo
*~
.DS_Store
compile_commands.json

# Compiled objects
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.elf
*.hex
*.bin

# Simulator output
ardubot-sim
ardubot-sim.exe
*.img

# Test output
*.gcda
*.gcno
*.gcov
coverage.info
coverage/
lcov.info
*.xml
junit.xml

# Logs
*.log

# Unity test framework (if not submodule)
tests/unity/src/
tests/unity/extras/

# Tools
tools/ardubot-cli/build/
tools/asset-pack/__pycache__/
tools/asset-pack/*.pyc

# Documentation build
docs/_build/
# Accidental in-tree CMake dumps
build5/

# Python
scripts/__pycache__/
*.pyc
