# Minimal Doxygen config for ArdubotOS's public C API.
# Run: doxygen Doxyfile   (output lands in docs/doxygen/html, gitignored)

PROJECT_NAME           = "ArdubotOS"
PROJECT_BRIEF          = "Multi-architecture embedded OS (AVR/ESP8266/ESP32, SDL2 simulator)"
OUTPUT_DIRECTORY       = docs/doxygen
GENERATE_LATEX         = NO
GENERATE_HTML          = YES
RECURSIVE              = YES
EXTRACT_ALL             = NO
EXTRACT_STATIC          = NO
QUIET                   = YES
WARN_IF_UNDOCUMENTED    = NO

INPUT                   = kernel hal/include apps fs drivers sim
FILE_PATTERNS           = *.h
EXCLUDE_PATTERNS        = */third_party/* */build/*

JAVADOC_AUTOBRIEF       = YES
OPTIMIZE_OUTPUT_FOR_C   = YES
